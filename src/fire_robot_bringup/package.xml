  <exec_depend>fire_robot_description</exec_depend>
  <exec_depend>fire_robot_perception</exec_depend>
  <exec_depend>fire_robot_navigation</exec_depend>
  <exec_depend>fire_robot_manipulation</exec_depend>
  <exec_depend>fire_robot_fsm</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>slam_toolbox</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
