      <pose>3.20 -1.08 0.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.35 0.50 0.50</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.35 0.50 0.50</size></box></geometry>
