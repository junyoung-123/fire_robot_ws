<?xml version='1.0'?>
<sdf version='1.6'>
  <world name='physical_contact_door_test'>
    <physics name='default_physics' type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Sensors' filename='gz-sim-sensors-system'>
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type='directional' name='sun'>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <model name='ground'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
        </collision>
        <visual name='visual'>
          <geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry>
          <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name='proof_overhead_camera'>
      <static>true</static>
      <pose>-2.80 0.00 5.00 0 1.5708 0</pose>
      <link name='link'>
        <sensor name='proof_overhead_camera' type='camera'>
          <always_on>true</always_on>
          <update_rate>10</update_rate>
          <topic>/proof/overhead/image</topic>
          <camera name='proof_overhead'>
            <horizontal_fov>1.20</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.10</near>
              <far>20.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <model name='proof_perspective_camera'>
      <static>true</static>
      <pose>-4.20 -2.50 2.20 0 0.46 0.97</pose>
      <link name='link'>
        <sensor name='proof_perspective_camera' type='camera'>
          <always_on>true</always_on>
          <update_rate>15</update_rate>
          <topic>/proof/perspective/image</topic>
          <camera name='proof_perspective'>
            <horizontal_fov>1.18</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.10</near>
              <far>20.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>

    <model name='blue_hinged_contact_door'>
      <pose>-2.495 -0.40 0 0 0 0</pose>
      <self_collide>true</self_collide>
      <link name='frame'>
        <inertial>
          <mass>20</mass>
          <inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia>
        </inertial>
        <visual name='hinge_post'>
          <pose>0 0 1.0 0 0 0</pose>
          <geometry><box><size>0.10 0.08 2.05</size></box></geometry>
          <material><ambient>0.12 0.12 0.12 1</ambient><diffuse>0.12 0.12 0.12 1</diffuse></material>
        </visual>
        <!-- The fixed strike catches the lever-driven latch bolt while the
             panel is closed. Pressing the lever drops the bolt clear. -->
        <collision name='latch_strike_collision'>
          <pose>0.055 0.84 0.83 0 0 0</pose>
          <geometry><box><size>0.04 0.08 0.05</size></box></geometry>
          <surface>
            <friction><ode><mu>0.7</mu><mu2>0.7</mu2></ode></friction>
            <contact><ode><kp>800000</kp><kd>40</kd></ode></contact>
          </surface>
        </collision>
        <visual name='latch_strike_visual'>
          <pose>0.055 0.84 0.83 0 0 0</pose>
          <geometry><box><size>0.04 0.08 0.05</size></box></geometry>
          <material><ambient>0.55 0.55 0.55 1</ambient><diffuse>0.55 0.55 0.55 1</diffuse></material>
        </visual>
      </link>
      <joint name='frame_fixed' type='fixed'>
        <parent>world</parent>
        <child>frame</child>
      </joint>

      <link name='panel'>
        <pose>0 0.40 1.0 0 0 0</pose>
        <inertial>
          <mass>18.0</mass>
          <inertia><ixx>6.96</ixx><iyy>6.01</iyy><izz>0.97</izz></inertia>
        </inertial>
        <collision name='panel_collision'>
          <geometry><box><size>0.06 0.80 2.0</size></box></geometry>
          <surface>
            <friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction>
            <contact><ode><kp>600000</kp><kd>30</kd></ode></contact>
          </surface>
        </collision>
        <visual name='panel_visual'>
          <geometry><box><size>0.06 0.80 2.0</size></box></geometry>
          <material><ambient>0.04 0.14 0.92 1</ambient><diffuse>0.04 0.14 0.92 1</diffuse></material>
        </visual>

        <collision name='handle_mount_collision'>
          <pose>-0.078 0.11 -0.17 0 0 0</pose>
          <geometry><box><size>0.05 0.06 0.10</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
            <contact><ode><kp>800000</kp><kd>40</kd></ode></contact>
          </surface>
        </collision>
        <visual name='handle_mount_visual'>
          <pose>-0.078 0.11 -0.17 0 0 0</pose>
          <geometry><box><size>0.05 0.06 0.10</size></box></geometry>
          <material><ambient>0.8 0.65 0.05 1</ambient><diffuse>0.8 0.65 0.05 1</diffuse></material>
        </visual>
      </link>

      <!-- The lever is an actual articulated link. It starts horizontal and
           rotates downward around the X axis when the gripper presses it. -->
      <link name='lever'>
        <pose>-0.075 0.51 0.83 0 0 0</pose>
        <inertial>
          <mass>0.22</mass>
          <inertia>
            <ixx>0.0013</ixx><iyy>0.00015</iyy><izz>0.0013</izz>
          </inertia>
        </inertial>
        <collision name='lever_collision'>
          <pose>0 0.13 0 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.026</radius><length>0.26</length></cylinder></geometry>
          <surface>
            <friction><ode><mu>5.0</mu><mu2>5.0</mu2></ode></friction>
            <contact><ode><kp>800000</kp><kd>40</kd></ode></contact>
          </surface>
        </collision>
        <visual name='lever_visual'>
          <pose>0 0.13 0 1.5708 0 0</pose>
          <geometry><cylinder><radius>0.026</radius><length>0.26</length></cylinder></geometry>
          <material><ambient>0.8 0.65 0.05 1</ambient><diffuse>0.8 0.65 0.05 1</diffuse></material>
        </visual>
        <!-- The bolt is rigidly part of the lever link. At rest it blocks
             against the strike; lever rotation lowers it out of the slot. -->
        <collision name='latch_bolt_collision'>
          <pose>0.05 0.32 0 0 0 0</pose>
          <geometry><box><size>0.10 0.05 0.03</size></box></geometry>
          <surface>
            <friction><ode><mu>0.35</mu><mu2>0.35</mu2></ode></friction>
            <contact><ode><kp>800000</kp><kd>40</kd></ode></contact>
          </surface>
        </collision>
        <visual name='latch_bolt_visual'>
          <pose>0.05 0.32 0 0 0 0</pose>
          <geometry><box><size>0.10 0.05 0.03</size></box></geometry>
          <material><ambient>0.7 0.7 0.7 1</ambient><diffuse>0.7 0.7 0.7 1</diffuse></material>
        </visual>
      </link>

      <joint name='lever_joint' type='revolute'>
        <!-- Joint pose is relative to the child link in SDF 1.6. -->
        <pose>0 0 0 0 0 0</pose>
        <parent>panel</parent>
        <child>lever</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit><lower>-0.55</lower><upper>0.10</upper><effort>25</effort><velocity>1.2</velocity></limit>
          <dynamics>
            <damping>0.40</damping><friction>0.04</friction>
            <spring_reference>0.0</spring_reference><spring_stiffness>6.0</spring_stiffness>
          </dynamics>
        </axis>
      </joint>

      <joint name='door_hinge' type='revolute'>
        <!-- Panel origin is at its center; place the pivot at the frame edge. -->
        <pose>0 -0.40 0 0 0 0</pose>
        <parent>frame</parent>
        <child>panel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-2.25</lower><upper>0.05</upper><effort>120</effort><velocity>2.0</velocity></limit>
          <dynamics><damping>0.80</damping><friction>2.0</friction></dynamics>
        </axis>
      </joint>
      <plugin filename='gz-sim-joint-state-publisher-system' name='gz::sim::systems::JointStatePublisher'>
        <topic>/door_joint_states</topic>
      </plugin>
    </model>
  </world>
</sdf>
