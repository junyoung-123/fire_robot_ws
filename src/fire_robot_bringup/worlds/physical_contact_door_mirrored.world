        </inertial>
        <collision name="lever_collision">
          <pose>0 -0.13 0 -1.5708 0 -0</pose>
          <geometry>
            <cylinder>
              <radius>0.026</radius>
              <length>0.26</length>
            </cylinder>
          </geometry>
          <surface>
            <friction>
