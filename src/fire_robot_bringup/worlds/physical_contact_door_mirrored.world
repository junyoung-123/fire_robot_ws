            <topic>/proof/contact/panel</topic>
          </contact>
          <always_on>true</always_on>
          <update_rate>20</update_rate>
        </sensor>
      </link>
      <link name="lever">
        <pose>-0.075 -0.51 0.83 -0 0 -0</pose>
        <inertial>
          <mass>0.22</mass>
          <inertia>
            <ixx>0.0013</ixx>
            <iyy>0.00015</iyy>
            <izz>0.0013</izz>
