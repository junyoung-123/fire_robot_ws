        </visual>
        <collision name="latch_bolt_collision">
          <pose>0.075 -0.32 0 -0 0 -0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.03</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.35</mu>
                <mu2>0.35</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>800000</kp>
                <kd>40</kd>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="latch_bolt_visual">
          <pose>0.075 -0.32 0 -0 0 -0</pose>
          <geometry>
            <box>
              <size>0.05 0.05 0.03</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>
        <sensor name="lever_contact_diagnostic" type="contact">
          <contact>
            <collision>lever_collision</collision>
            <topic>/proof/contact/lever</topic>
          </contact>
          <always_on>true</always_on>
          <update_rate>20</update_rate>
        </sensor>
        <sensor name="latch_contact_diagnostic" type="contact">
          <contact>
            <collision>latch_bolt_collision</collision>
            <topic>/proof/contact/latch</topic>
          </contact>
          <always_on>true</always_on>
          <update_rate>20</update_rate>
        </sensor>
      </link>
      <joint name="lever_joint" type="revolute">
        <pose>0 -0 0 -0 0 -0</pose>
        <parent>panel</parent>
        <child>lever</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit>
            <lower>-0.1</lower>
            <upper>0.55</upper>
            <effort>25</effort>
            <velocity>1.2</velocity>
          </limit>
          <dynamics>
            <damping>0.40</damping>
            <friction>0.04</friction>
            <spring_reference>-0</spring_reference>
            <spring_stiffness>6.0</spring_stiffness>
          </dynamics>
        </axis>
      </joint>
      <joint name="door_hinge" type="revolute">
        <pose>0 0.4 0 -0 0 -0</pose>
        <parent>frame</parent>
        <child>panel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit>
            <lower>-0.05</lower>
            <upper>2.25</upper>
            <effort>120</effort>
            <velocity>2.0</velocity>
          </limit>
          <dynamics>
            <damping>0.80</damping>
            <friction>2.0</friction>
          </dynamics>
        </axis>
      </joint>
      <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
        <topic>/door_joint_states</topic>
      </plugin>
    </model>
