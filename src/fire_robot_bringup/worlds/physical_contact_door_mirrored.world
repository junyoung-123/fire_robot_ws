<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.6">
  <world name="physical_contact_door_test">
    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system" />
    <plugin name="gz::sim::systems::Contact" filename="ignition-gazebo-contact-system" />
    <plugin name="fire_robot::ContactAudit" filename="libfire_robot_contact_audit.so" />
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system" />
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system" />
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>
    <light type="directional" name="sun">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <direction>-0.3 0.2 -1</direction>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>20 20</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.45 0.45 0.45 1</ambient>
            <diffuse>0.45 0.45 0.45 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="proof_overhead_camera">
      <static>true</static>
      <pose>-2.80 0.00 5.00 0 1.5708 0</pose>
      <link name="link">
        <sensor name="proof_overhead_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>3</update_rate>
          <topic>/proof/overhead/image</topic>
          <camera name="proof_overhead">
            <horizontal_fov>1.20</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.10</near>
              <far>20.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>
    <model name="proof_perspective_camera">
      <static>true</static>
      <pose>-4.20 -2.50 2.20 0 0.46 0.97</pose>
      <link name="link">
        <sensor name="proof_perspective_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>3</update_rate>
          <topic>/proof/perspective/image</topic>
          <camera name="proof_perspective">
            <horizontal_fov>1.18</horizontal_fov>
            <image>
              <width>1280</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.10</near>
              <far>20.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>
    <model name="proof_handle_camera">
      <static>true</static>
      <pose>-3.10 -0.70 1.20 0 0.34 1.02</pose>
      <link name="link">
        <sensor name="proof_handle_camera" type="camera">
          <always_on>true</always_on>
          <update_rate>3</update_rate>
          <topic>/proof/handle/image</topic>
          <camera name="proof_handle">
            <horizontal_fov>0.80</horizontal_fov>
            <image>
              <width>960</width>
              <height>720</height>
              <format>R8G8B8</format>
            </image>
            <clip>
              <near>0.05</near>
              <far>10.0</far>
            </clip>
          </camera>
        </sensor>
      </link>
    </model>
    <model name="blue_hinged_contact_door">
      <pose>-2.495 0.4 0 -0 0 -0</pose>
      <self_collide>true</self_collide>
      <link name="frame">
        <inertial>
          <mass>20</mass>
          <inertia>
            <ixx>1</ixx>
            <iyy>1</iyy>
            <izz>1</izz>
          </inertia>
        </inertial>
        <collision name="hinge_post_collision">
          <pose>-0.08 0.05 1 -0 0 -0</pose>
          <geometry>
            <box>
              <size>0.10 0.08 2.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="hinge_post">
          <pose>-0.08 0.05 1 -0 0 -0</pose>
          <geometry>
            <box>
              <size>0.10 0.08 2.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.12 0.12 0.12 1</ambient>
            <diffuse>0.12 0.12 0.12 1</diffuse>
          </material>
        </visual>
        <collision name="latch_strike_collision">
          <pose>0.055 -0.84 0.83 -0 0 -0</pose>
          <geometry>
            <box>
              <size>0.04 0.08 0.05</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.7</mu>
                <mu2>0.7</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>800000</kp>
                <kd>40</kd>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="latch_strike_visual">
          <pose>0.055 -0.84 0.83 -0 0 -0</pose>
          <geometry>
            <box>
              <size>0.04 0.08 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
        <sensor name="jamb_contacts" type="contact">
          <contact>
            <collision>hinge_post_collision</collision>
            <topic>/proof/contact/jamb</topic>
          </contact>
          <always_on>true</always_on>
          <update_rate>20</update_rate>
        </sensor>
        <sensor name="strike_contacts" type="contact">
          <contact>
            <collision>latch_strike_collision</collision>
            <topic>/proof/contact/strike</topic>
          </contact>
          <always_on>true</always_on>
          <update_rate>20</update_rate>
        </sensor>
      </link>
      <joint name="frame_fixed" type="fixed">
        <parent>world</parent>
        <child>frame</child>
      </joint>
      <link name="panel">
        <pose>0 -0.4 1 -0 0 -0</pose>
        <inertial>
          <mass>18.0</mass>
          <inertia>
            <ixx>6.96</ixx>
            <iyy>6.01</iyy>
            <izz>0.97</izz>
          </inertia>
        </inertial>
        <collision name="panel_collision">
          <geometry>
