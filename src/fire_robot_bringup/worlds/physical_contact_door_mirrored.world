          <pose>-0.078 -0.11 -0.17 -0 0 -0</pose>
          <geometry>
            <box>
              <size>0.05 0.06 0.10</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.8</mu>
                <mu2>0.8</mu2>
              </ode>
            </friction>
            <contact>
              <ode>
                <kp>800000</kp>
                <kd>40</kd>
              </ode>
            </contact>
          </surface>
        </collision>
        <visual name="handle_mount_visual">
          <pose>-0.078 -0.11 -0.17 -0 0 -0</pose>
