<?xml version="1.0" ?>
<!--
  fire_corridor.world

  Corridor simulation layout:
    - Robot starts near X=-3, facing +X.
    - Six side doors are placed along the left/right corridor walls.
    - Red and blue doors are mixed to exercise fire/safe-door classification.
    - The green emergency exit door is placed at the front end of the corridor.
    - Door panels are visual markers without collision so sim_mode door opening
      can complete and the robot can keep driving through the corridor.

  Door layout:
    X= 0, Y=+1.55 : red
    X= 3, Y=-1.55 : blue
    X= 6, Y=+1.55 : red
    X= 9, Y=-1.55 : blue
    X=12, Y=+1.55 : blue
    X=15, Y=-1.55 : red
    X=17.92, Y=0  : green exit
-->
<sdf version="1.6">
  <world name="fire_corridor">

    <physics name="default_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>6 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.5 0.1 -1</direction>
    </light>
    <light type="point" name="light_mid">
      <pose>8 0 2.8 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>16</range><linear>0.05</linear></attenuation>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="col">
          <geometry><plane><normal>0 0 1</normal><size>30 10</size></plane></geometry>
        </collision>
        <visual name="vis">
          <geometry><plane><normal>0 0 1</normal><size>30 10</size></plane></geometry>
          <material><ambient>0.72 0.72 0.68 1</ambient><diffuse>0.72 0.72 0.68 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>6.5 -2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>23 0.2 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>23 0.2 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.80 1</ambient><diffuse>0.85 0.85 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>6.5 2 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>23 0.2 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>23 0.2 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.80 1</ambient><diffuse>0.85 0.85 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-5 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 4 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.2 4 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.80 1</ambient><diffuse>0.85 0.85 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>18 0 1.25 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.2 4 2.5</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.2 4 2.5</size></box></geometry>
          <material><ambient>0.85 0.85 0.80 1</ambient><diffuse>0.85 0.85 0.80 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Side doors: visual only, no collision. -->
    <model name="door_red1">
      <static>true</static>
      <pose>0 1.55 1.0 0 0 0</pose>
      <link name="link">
        <visual name="panel">
          <geometry><box><size>0.06 0.8 2.0</size></box></geometry>
          <material><ambient>0.92 0.04 0.04 1</ambient><diffuse>0.92 0.04 0.04 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="handle_red1">
      <static>true</static>
      <pose>0.04 1.25 0.95 0 1.5708 0</pose>
      <link name="link">
        <visual name="handle"><geometry><cylinder><radius>0.018</radius><length>0.13</length></cylinder></geometry><material><ambient>0.75 0.60 0.05 1</ambient></material></visual>
      </link>
    </model>

    <model name="door_blue1">
      <static>false</static>
      <pose>3 -1.55 1 0 0 0</pose>
      <link name="panel">
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.90</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.90</iyy><iyz>0</iyz><izz>0.12</izz>
          </inertia>
        </inertial>
        <collision name="panel_collision">
          <geometry><box><size>0.06 0.8 2</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="panel">
          <geometry><box><size>0.06 0.8 2</size></box></geometry>
          <material><ambient>0.04 0.14 0.92 1</ambient><diffuse>0.04 0.14 0.92 1</diffuse></material>
        </visual>
        <collision name="handle_collision">
<pose>0.074 0.36 -0.05 0 0 0</pose>
<geometry><box><size>0.07 0.32 0.055</size></box></geometry>
        </collision>
        <visual name="handle_backplate">
<pose>0.032 0.24 -0.05 0 0 0</pose>
<geometry><box><size>0.022 0.08 0.28</size></box></geometry>
<material><ambient>0.75 0.60 0.05 1</ambient><diffuse>0.75 0.60 0.05 1</diffuse></material>
        </visual>
        <visual name="handle">
<pose>0.078 0.36 -0.05 0 0 0</pose>
<geometry><box><size>0.052 0.32 0.052</size></box></geometry>
<material><ambient>0.75 0.60 0.05 1</ambient><diffuse>0.75 0.60 0.05 1</diffuse></material>
        </visual>
      </link>
      <joint name="hinge" type="revolute">
        <pose>0 -0.4 0 0 0 0</pose>
        <parent>world</parent>
        <child>panel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-2.10</lower><upper>2.10</upper><effort>40</effort><velocity>1.5</velocity></limit>
          <dynamics><damping>1.0</damping><friction>0.05</friction></dynamics>
        </axis>
      </joint>
      <plugin filename="ignition-gazebo-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>hinge</joint_name>
        <topic>/fire_robot/door/blue/x300/yn155/sn/cmd</topic>
        <p_gain>8.0</p_gain>
        <d_gain>0.4</d_gain>
        <cmd_max>60</cmd_max>
        <cmd_min>-60</cmd_min>
      </plugin>
    </model>

    <model name="door_red2">
      <static>true</static>
      <pose>6 1.55 1.0 0 0 0</pose>
      <link name="link">
        <visual name="panel">
          <geometry><box><size>0.06 0.8 2.0</size></box></geometry>
          <material><ambient>0.92 0.04 0.04 1</ambient><diffuse>0.92 0.04 0.04 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="handle_red2">
      <static>true</static>
      <pose>6.04 1.25 0.95 0 1.5708 0</pose>
      <link name="link">
        <visual name="handle"><geometry><cylinder><radius>0.018</radius><length>0.13</length></cylinder></geometry><material><ambient>0.75 0.60 0.05 1</ambient></material></visual>
      </link>
    </model>

    <model name="door_blue2">
      <static>false</static>
      <pose>9 -1.55 1 0 0 0</pose>
      <link name="panel">
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.90</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.90</iyy><iyz>0</iyz><izz>0.12</izz>
          </inertia>
        </inertial>
        <collision name="panel_collision">
          <geometry><box><size>0.06 0.8 2</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="panel">
          <geometry><box><size>0.06 0.8 2</size></box></geometry>
          <material><ambient>0.04 0.14 0.92 1</ambient><diffuse>0.04 0.14 0.92 1</diffuse></material>
        </visual>
        <collision name="handle_collision">
<pose>0.074 0.36 -0.05 0 0 0</pose>
<geometry><box><size>0.07 0.32 0.055</size></box></geometry>
        </collision>
        <visual name="handle_backplate">
<pose>0.032 0.24 -0.05 0 0 0</pose>
<geometry><box><size>0.022 0.08 0.28</size></box></geometry>
<material><ambient>0.75 0.60 0.05 1</ambient><diffuse>0.75 0.60 0.05 1</diffuse></material>
        </visual>
        <visual name="handle">
<pose>0.078 0.36 -0.05 0 0 0</pose>
<geometry><box><size>0.052 0.32 0.052</size></box></geometry>
<material><ambient>0.75 0.60 0.05 1</ambient><diffuse>0.75 0.60 0.05 1</diffuse></material>
        </visual>
      </link>
      <joint name="hinge" type="revolute">
        <pose>0 -0.4 0 0 0 0</pose>
        <parent>world</parent>
        <child>panel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-2.10</lower><upper>2.10</upper><effort>40</effort><velocity>1.5</velocity></limit>
          <dynamics><damping>1.0</damping><friction>0.05</friction></dynamics>
        </axis>
      </joint>
      <plugin filename="ignition-gazebo-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>hinge</joint_name>
        <topic>/fire_robot/door/blue/x900/yn155/sn/cmd</topic>
        <p_gain>8.0</p_gain>
        <d_gain>0.4</d_gain>
        <cmd_max>60</cmd_max>
        <cmd_min>-60</cmd_min>
      </plugin>
    </model>

    <model name="door_blue3">
      <static>false</static>
      <pose>12 1.55 1 0 0 0</pose>
      <link name="panel">
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.90</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.90</iyy><iyz>0</iyz><izz>0.12</izz>
          </inertia>
        </inertial>
        <collision name="panel_collision">
          <geometry><box><size>0.06 0.8 2</size></box></geometry>
          <surface>
            <friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="panel">
          <geometry><box><size>0.06 0.8 2</size></box></geometry>
          <material><ambient>0.04 0.14 0.92 1</ambient><diffuse>0.04 0.14 0.92 1</diffuse></material>
        </visual>
        <collision name="handle_collision">
<pose>0.074 -0.36 -0.05 0 0 0</pose>
<geometry><box><size>0.07 0.32 0.055</size></box></geometry>
        </collision>
        <visual name="handle_backplate">
<pose>0.032 -0.24 -0.05 0 0 0</pose>
<geometry><box><size>0.022 0.08 0.28</size></box></geometry>
<material><ambient>0.75 0.60 0.05 1</ambient><diffuse>0.75 0.60 0.05 1</diffuse></material>
        </visual>
        <visual name="handle">
<pose>0.078 -0.36 -0.05 0 0 0</pose>
<geometry><box><size>0.052 0.32 0.052</size></box></geometry>
<material><ambient>0.75 0.60 0.05 1</ambient><diffuse>0.75 0.60 0.05 1</diffuse></material>
        </visual>
      </link>
      <joint name="hinge" type="revolute">
        <pose>0 0.4 0 0 0 0</pose>
        <parent>world</parent>
        <child>panel</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>-2.10</lower><upper>2.10</upper><effort>40</effort><velocity>1.5</velocity></limit>
          <dynamics><damping>1.0</damping><friction>0.05</friction></dynamics>
        </axis>
      </joint>
      <plugin filename="ignition-gazebo-joint-position-controller-system"
              name="gz::sim::systems::JointPositionController">
        <joint_name>hinge</joint_name>
        <topic>/fire_robot/door/blue/x1200/yp155/sp/cmd</topic>
        <p_gain>8.0</p_gain>
        <d_gain>0.4</d_gain>
        <cmd_max>60</cmd_max>
        <cmd_min>-60</cmd_min>
      </plugin>
    </model>

    <model name="door_red3">
      <static>true</static>
      <pose>15 -1.55 1.0 0 0 0</pose>
      <link name="link">
        <visual name="panel">
          <geometry><box><size>0.06 0.8 2.0</size></box></geometry>
          <material><ambient>0.92 0.04 0.04 1</ambient><diffuse>0.92 0.04 0.04 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="handle_red3">
      <static>true</static>
      <pose>15.04 -1.25 0.95 0 1.5708 0</pose>
      <link name="link">
        <visual name="handle"><geometry><cylinder><radius>0.018</radius><length>0.13</length></cylinder></geometry><material><ambient>0.75 0.60 0.05 1</ambient></material></visual>
      </link>
    </model>

    <!-- Front emergency exit. -->
    <model name="door_exit">
      <static>true</static>
      <pose>17.92 0 1.0 0 0 0</pose>
      <link name="link">
        <visual name="panel">
          <geometry><box><size>0.06 0.9 2.0</size></box></geometry>
          <material><ambient>0.0 0.88 0.05 1</ambient><diffuse>0.0 0.88 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="handle_exit">
      <static>true</static>
      <pose>17.88 -0.30 0.95 0 1.5708 0</pose>
      <link name="link">
        <visual name="handle"><geometry><cylinder><radius>0.018</radius><length>0.13</length></cylinder></geometry><material><ambient>0.75 0.60 0.05 1</ambient></material></visual>
      </link>
    </model>

    <model name="obstacle1">
      <static>true</static>
      <pose>4.5 0.55 0.35 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.45 0.45 0.70</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.45 0.45 0.70</size></box></geometry>
          <material><ambient>0.45 0.32 0.20 1</ambient><diffuse>0.45 0.32 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle2">
      <static>true</static>
      <pose>10.5 -0.55 0.40 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.45 0.45 0.80</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.45 0.45 0.80</size></box></geometry>
          <material><ambient>0.45 0.32 0.20 1</ambient><diffuse>0.45 0.32 0.20 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
