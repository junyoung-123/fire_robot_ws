<?xml version='1.0'?>
<sdf version='1.6'>
  <world name='manipulation_demo'>
    <physics name='default_physics' type='ode'><max_step_size>0.001</max_step_size><real_time_update_rate>1000</real_time_update_rate></physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <light type='directional' name='sun'><pose>0 0 8 0 0 0</pose><diffuse>0.9 0.9 0.9 1</diffuse><direction>-0.3 0.2 -1</direction></light>
    <model name='ground'><static>true</static><link name='link'><collision name='collision'><geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry></collision><visual name='visual'><geometry><plane><normal>0 0 1</normal><size>8 8</size></plane></geometry></visual></link></model>
    <model name='blue_hinged_door'>
      <pose>-2.35 -0.40 0 0 0 0</pose>
      <link name='frame'><inertial><mass>20</mass><inertia><ixx>1</ixx><iyy>1</iyy><izz>1</izz></inertia></inertial></link>
      <joint name='frame_fixed' type='fixed'><parent>world</parent><child>frame</child></joint>
      <link name='panel'>
        <pose>0 0.40 1.0 0 0 0</pose>
        <inertial><mass>8</mass><inertia><ixx>3.1</ixx><iyy>2.7</iyy><izz>0.43</izz></inertia></inertial>
        <collision name='panel_collision'><geometry><box><size>0.06 0.80 2.0</size></box></geometry></collision>
        <visual name='panel_visual'><geometry><box><size>0.06 0.80 2.0</size></box></geometry><material><ambient>0.04 0.14 0.92 1</ambient><diffuse>0.04 0.14 0.92 1</diffuse></material></visual>
        <visual name='handle'><pose>0.07 0.25 -0.05 0 1.5708 0</pose><geometry><cylinder><radius>0.025</radius><length>0.16</length></cylinder></geometry><material><ambient>0.8 0.65 0.05 1</ambient></material></visual>
      </link>
      <joint name='door_hinge' type='revolute'><parent>frame</parent><child>panel</child><axis><xyz>0 0 1</xyz><limit><lower>0</lower><upper>1.35</upper><effort>80</effort><velocity>1.0</velocity></limit><dynamics><damping>2.0</damping></dynamics></axis></joint>
      <plugin filename='ignition-gazebo-joint-position-controller-system' name='gz::sim::systems::JointPositionController'><joint_name>door_hinge</joint_name><topic>/sim/door_hinge_position_cmd</topic><p_gain>35</p_gain><d_gain>5</d_gain><cmd_max>60</cmd_max><cmd_min>-60</cmd_min></plugin>
      <plugin filename='gz-sim-joint-state-publisher-system' name='gz::sim::systems::JointStatePublisher'><topic>/door_joint_states</topic></plugin>
    </model>
  </world>
</sdf>
