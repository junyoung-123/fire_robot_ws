<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!--
    AgileX PIPER geometry and dynamics adapted from the user-supplied
    src_hyu_jackal_piper/piper_description package. Link dimensions, joint
    origins, axes, masses, inertia tensors and limits match that description.
    Project link names are retained so the existing FSM/MoveIt configuration
    continues to refer to one unambiguous mobile-manipulator tree.
  -->
  <xacro:macro name="piper_actual_link"
               params="name mesh mass ixyz ioff collision_xyz collision_size">
    <link name="${name}">
      <inertial>
        <origin xyz="${ioff}" rpy="0 0 0"/>
        <mass value="${mass}"/>
        <inertia ixx="${ixyz[0]}" ixy="${ixyz[1]}" ixz="${ixyz[2]}"
                 iyy="${ixyz[3]}" iyz="${ixyz[4]}" izz="${ixyz[5]}"/>
      </inertial>
      <visual>
        <geometry>
          <mesh filename="package://fire_robot_description/meshes/piper/${mesh}"/>
        </geometry>
        <material name="piper_white">
          <color rgba="0.7921568627 0.8196078431 0.9333333333 1"/>
        </material>
      </visual>
      <collision>
        <origin xyz="${collision_xyz}" rpy="0 0 0"/>
        <geometry>
          <box size="${collision_size}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <xacro:macro name="piper_arm_actual" params="parent mount_xyz mount_rpy">
    <xacro:piper_actual_link
      name="arm_base_link" mesh="base_link.STL" mass="1.02"
      ioff="-0.0047364116 0.0000256829 0.0414515180"
      collision_xyz="-0.00925 0 0.043" collision_size="0.0985 0.0800 0.0860"
      ixyz="${[0.00267433, -0.00000073, -0.00017389, 0.00282612, 0.00000040, 0.00089624]}"/>
    <joint name="arm_base_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="arm_base_link"/>
      <origin xyz="${mount_xyz}" rpy="${mount_rpy}"/>
    </joint>

    <xacro:piper_actual_link
      name="arm_link1" mesh="link1.STL" mass="0.71"
      ioff="0.0001215047 0.0001046322 -0.0043859731"
      collision_xyz="0.00005 0.00200 -0.00650" collision_size="0.0719 0.0775 0.0730"
      ixyz="${[0.00048916, -0.00000036, -0.00000224, 0.00040472, -0.00000242, 0.00043982]}"/>
    <joint name="joint1" type="revolute">
      <origin xyz="0 0 0.123" rpy="0 0 0"/>
      <parent link="arm_base_link"/>
      <child link="arm_link1"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.618" upper="2.168" effort="100" velocity="5"/>
      <dynamics damping="0.08" friction="0.02"/>
    </joint>

    <xacro:piper_actual_link
      name="arm_link2" mesh="link2.STL" mass="1.17"
      ioff="0.1986661452 -0.0109269241 0.0014212171"
      collision_xyz="0.14253 -0.01655 0" collision_size="0.3480 0.0966 0.0970"
      ixyz="${[0.00116918, -0.00180037, 0.00025146, 0.06785384, -0.00000455, 0.06774489]}"/>
    <joint name="joint2" type="revolute">
      <origin xyz="0 0 0" rpy="1.5708 -0.1359 -3.1416"/>
      <parent link="arm_link1"/>
      <child link="arm_link2"/>
      <axis xyz="0 0 1"/>
      <limit lower="0" upper="3.14" effort="100" velocity="5"/>
      <dynamics damping="0.10" friction="0.025"/>
    </joint>

    <xacro:piper_actual_link
      name="arm_link3" mesh="link3.STL" mass="0.5"
      ioff="-0.0202737662 -0.1339149959 -0.0004586827"
      collision_xyz="-0.01311 -0.09239 0.00038" collision_size="0.0861 0.2448 0.0808"
      ixyz="${[0.01361711, 0.00165794, -0.00000048, 0.00045024, -0.00000045, 0.01380322]}"/>
    <joint name="joint3" type="revolute">
      <origin xyz="0.28503 0 0" rpy="0 0 -1.7939"/>
      <parent link="arm_link2"/>
      <child link="arm_link3"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.967" upper="0" effort="100" velocity="5"/>
      <dynamics damping="0.08" friction="0.02"/>
    </joint>

    <xacro:piper_actual_link
      name="arm_link4" mesh="link4.STL" mass="0.38"
      ioff="-0.0000966636 0.0008760645 -0.0049688090"
      collision_xyz="-0.00152 0.00204 -0.00378" collision_size="0.0628 0.0611 0.0645"
      ixyz="${[0.00018501, 0.00000054, 0.00000120, 0.00018965, -0.00000841, 0.00015484]}"/>
    <joint name="joint4" type="revolute">
      <origin xyz="-0.021984 -0.25075 0" rpy="1.5708 0 0"/>
      <parent link="arm_link3"/>
      <child link="arm_link4"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.745" upper="1.745" effort="100" velocity="5"/>
      <dynamics damping="0.05" friction="0.015"/>
    </joint>

    <xacro:piper_actual_link
      name="arm_link5" mesh="link5.STL" mass="0.383"
      ioff="-0.0000410554 -0.0566486692 -0.0037205792"
      collision_xyz="0 -0.03326 -0.00196" collision_size="0.0600 0.1135 0.0610"
      ixyz="${[0.00166169, 0.00000006, -0.00000007, 0.00018510, 0.00001026, 0.00164321]}"/>
    <joint name="joint5" type="revolute">
      <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
      <parent link="arm_link4"/>
      <child link="arm_link5"/>
      <axis xyz="0 0 1"/>
      <limit lower="-1.22" upper="1.22" effort="100" velocity="5"/>
      <dynamics damping="0.04" friction="0.01"/>
    </joint>

    <xacro:piper_actual_link
      name="arm_link6" mesh="link6.STL" mass="0.0069908961"
      ioff="-0.0000882591 0.0000090598 -0.002"
      collision_xyz="-0.00006 0 -0.002" collision_size="0.0350 0.0350 0.0040"
      ixyz="${[0.0000005730, 0.0, 0.0, 0.0000005730, 0.0, 0.0000010674]}"/>
    <joint name="joint6" type="revolute">
      <origin xyz="0.000088259 -0.091 0" rpy="1.5708 0 0"/>
      <parent link="arm_link5"/>
      <child link="arm_link6"/>
      <axis xyz="0 0 1"/>
      <limit lower="-2.0944" upper="2.0944" effort="100" velocity="3"/>
      <dynamics damping="0.03" friction="0.008"/>
    </joint>

    <xacro:piper_actual_link
      name="gripper_base_link" mesh="gripper_base.STL" mass="0.45"
      ioff="-0.0001838072 0.0000805033 0.0321436690"
      collision_xyz="-0.00475 0 0.03150" collision_size="0.0705 0.1450 0.0630"
      ixyz="${[0.00092934, 0.00000034, -0.00000738, 0.00071447, 0.00000005, 0.00039442]}"/>
    <joint name="gripper_base_joint" type="fixed">
      <parent link="arm_link6"/>
      <child link="gripper_base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <!-- Official joint7/joint8 geometry, retaining project gripper joint names. -->
    <xacro:piper_actual_link
      name="gripper_finger_left" mesh="link7.STL" mass="0.025"
      ioff="0.0006512319 -0.0491929869 0.0097225877"
      collision_xyz="0 -0.03825 0.01325" collision_size="0.0560 0.0765 0.0265"
      ixyz="${[0.00001366, 0.0, 0.0, 0.00000800, 0.0, 0.00001873]}"/>
    <joint name="gripper_left_joint" type="prismatic">
      <origin xyz="0 0 0.1358" rpy="1.5708 0 0"/>
      <parent link="gripper_base_link"/>
      <child link="gripper_finger_left"/>
      <axis xyz="0 0 1"/>
      <limit lower="0" upper="0.035" effort="10" velocity="1"/>
      <dynamics damping="0.04" friction="0.02"/>
    </joint>

    <xacro:piper_actual_link
      name="gripper_finger_right" mesh="link8.STL" mass="0.025"
      ioff="0.0006512319 -0.0491929869 0.0097225877"
      collision_xyz="0 -0.03825 0.01325" collision_size="0.0560 0.0765 0.0265"
      ixyz="${[0.00001366, 0.0, 0.0, 0.00000800, 0.0, 0.00001873]}"/>
    <joint name="gripper_right_joint" type="prismatic">
      <origin xyz="0 0 0.1358" rpy="1.5708 0 -3.1416"/>
      <parent link="gripper_base_link"/>
      <child link="gripper_finger_right"/>
      <axis xyz="0 0 -1"/>
      <limit lower="-0.035" upper="0" effort="10" velocity="1"/>
      <dynamics damping="0.04" friction="0.02"/>
    </joint>

    <gazebo reference="gripper_finger_left">
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <kp>500000.0</kp>
      <kd>40.0</kd>
      <minDepth>0.0005</minDepth>
    </gazebo>
    <gazebo reference="gripper_finger_right">
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
      <kp>500000.0</kp>
      <kd>40.0</kd>
      <minDepth>0.0005</minDepth>
    </gazebo>
  </xacro:macro>
</robot>
