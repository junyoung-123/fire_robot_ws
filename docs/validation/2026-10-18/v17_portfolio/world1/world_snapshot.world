      <joint name="lever_joint" type="revolute">
        <pose>0 0 0 0 0 0</pose>
        <parent>panel</parent>
        <child>lever</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit>
            <lower>-0.55</lower>
            <upper>0.10</upper>
            <effort>25</effort>
            <velocity>1.2</velocity>
